# Day 01 示例配置文件
#
# 这个文件只做示例，不放真实 API Key。
# 本地开发时复制一份叫 .env，然后在 .env 里填写真实值。

DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
# 知识库语义检索使用的向量模型；不能与文档/问题两侧混用不同版本。
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
# Milvus 只存 Embedding 向量和检索标量字段，不替代 MySQL 业务数据。
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=knowledge_chunk_vectors_v2
# RAG 无答案拒答阈值：Top1 分数低于该值时不调用聊天模型，直接返回依据不足。
RAG_MIN_RELEVANCE_SCORE=0.25
APP_NAME=day04-ai-service
APP_HOST=127.0.0.1
APP_PORT=8000

# Celery 企业异步任务配置。
# RabbitMQ 作为 Broker，负责真正的消息投递与消费。
RABBITMQ_URL=amqp://python_ai:python_ai_123@127.0.0.1:5672//
CELERY_BROKER_URL=amqp://python_ai:python_ai_123@127.0.0.1:5672//
ASYNC_TASK_TIMEOUT_MINUTES=10
ASYNC_TASK_MAX_RETRIES=3

# Day27 API Key 认证。兼容旧课程时可保持 false；企业环境必须启用并由密钥管理系统注入。
SECURITY_ENABLED=false
# 这里只保存 SHA-256 哈希，绝不能保存原始 API Key。
# 字段：key_id、key_hash、actor_id、roles，以及可选 permissions。
SECURITY_API_KEYS_JSON=[]

# 金汤令 Java -> Python 的服务间认证。浏览器不能持有该 Key；Java 校验用户 Token 和
# 接口权限后，再使用 X-Service-API-Key 及 X-AI-* 头透传已认证的用户上下文。
# 字段：key_id、key_hash、service_id。原始服务 Key 应由密钥管理系统注入，不能提交到 Git。
SECURITY_SERVICE_API_KEYS_JSON=[]
